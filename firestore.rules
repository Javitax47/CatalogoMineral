rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Colección privada de cada usuario: solo su propietario puede leer y escribir.
    match /users/{userId}/minerals/{mineralId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Copia pública usada para compartir catálogos y para las fichas (ficha.html).
    // La lectura es abierta; la escritura solo la puede hacer el propietario.
    match /public_minerals/{mineralId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.owner == request.auth.uid;
    }

    // Enlaces para compartir. El identificador del documento es el uid del propietario.
    match /share_links/{token} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == token
                            && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == token;
    }
  }
}
