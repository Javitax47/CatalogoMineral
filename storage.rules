rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Imágenes de los minerales. Cada usuario solo puede escribir en su carpeta.
    // La lectura es pública para permitir ver los catálogos compartidos.
    match /users/{userId}/images/{fileName=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
